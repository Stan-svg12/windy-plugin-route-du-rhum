{
    "name": "windy-plugin-route-du-rhum",
    "version": "1.2.0",
    "description": "Plugin Windy : positions, trajectoires et classement de la Route du Rhum 2026 en direct",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && mkdir dist && SERVE=false rollup -c && cp package.json dist/",
        "start": "rollup -w -c",
        "tracks:update": "node scripts/update-tracks.mjs",
        "tracks:seed": "node scripts/update-tracks.mjs --seed && node scripts/embed-seed.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/__RDR_REPO__.git"
    },
    "keywords": [
        "windy",
        "windy-plugin",
        "route-du-rhum",
        "sailing",
        "tracker"
    ],
    "author": "Adrien Zucconi",
    "license": "ISC",
    "homepage": "https://docs.windy-plugins.com/",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.3"
    }
}
